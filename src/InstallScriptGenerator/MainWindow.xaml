<Window x:Class="InstallScriptGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/isg.ico" Title="Install Script Generator 2.0"
        Width="1460" Height="900" MinWidth="1100" MinHeight="715"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource WindowBrush}">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#07151D"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#11242E"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#1A3340"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#091B25"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A4552"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F0F8FC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A3B7C4"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#49D959"/>
    <SolidColorBrush x:Key="ActionTextBrush" Color="#071B16"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#244351"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#17634B"/>
    <SolidColorBrush x:Key="ComboTextBrush" Color="#F0F8FC"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#82EE78"/>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#173B3E" Offset="0"/>
      <GradientStop Color="#102630" Offset=".6"/>
      <GradientStop Color="#142F3D" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <!-- Checked boxes use the same green accent as action buttons. -->
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="4"
                      Background="{DynamicResource FieldBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="CheckMark" Width="12" Height="10"
                      Data="M 1 5 L 5 9 L 11 1"
                      Stroke="{DynamicResource ActionTextBrush}" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Stretch="Fill"
                      Visibility="Collapsed" HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
              </Border>
              <ContentPresenter ContentSource="Content" Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource TextBrush}"
                                RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Outer" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Outer" Property="Opacity" Value=".78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Outer" Property="Opacity" Value=".42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Outer" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Outer" Property="Opacity" Value=".4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Override the Windows default ComboBox chrome, which rendered white on white in dark mode. -->
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter ContentSource="Content"
                                TextElement.Foreground="{DynamicResource ComboTextBrush}"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <Border x:Name="ComboBorder" CornerRadius="6"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
              <ContentPresenter x:Name="ContentSite" Margin="11,2,34,2"
                                IsHitTestVisible="False" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                TextElement.Foreground="{DynamicResource ComboTextBrush}"/>
              <Path Fill="{DynamicResource ComboTextBrush}" Width="11" Height="6" Stretch="Fill"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                    Data="M 0 0 L 5.5 6 L 11 0 Z" IsHitTestVisible="False"/>
              <ToggleButton Focusable="False" BorderThickness="0" Background="Transparent"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent"/>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                     PopupAnimation="Fade">
                <Border Background="{DynamicResource FieldBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Margin="0,3,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="320">
                  <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ComboBorder" Property="Opacity" Value=".5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
      <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="9,9"/>
    </Style>
    <Style TargetType="{x:Type DataGridCell}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="5,5"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" CornerRadius="12" Margin="0,0,0,15"
            Padding="15,13" Background="{DynamicResource HeroBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Source="Assets/isg.ico" Width="55" Height="55" Margin="0,0,13,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Install Script Generator 2.0" FontWeight="Bold" FontSize="28"/>
        <TextBlock x:Name="SubtitleText" FontSize="12.5"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
      </StackPanel>
      <ComboBox x:Name="LanguageCombo" Grid.Column="2" Width="126" Margin="10,0"
                SelectionChanged="Language_Changed" VerticalAlignment="Center">
        <ComboBoxItem Content="Deutsch"/>
        <ComboBoxItem Content="English"/>
      </ComboBox>
      <Button x:Name="ThemeButton" Grid.Column="3" Content="☀"
              Margin="0,0,10,0" VerticalAlignment="Center" Click="Theme_Click"/>
      <Button x:Name="AboutButton" Grid.Column="4" Content="About"
              VerticalAlignment="Center" Click="About_Click"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="10,8" Margin="0,0,0,13">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="01" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
        <TextBlock x:Name="ScanStepText" Margin="8,0,25,0" Text="Directory scan"/>
        <TextBlock Text="02" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
        <TextBlock x:Name="FilesStepText" Margin="8,0,25,0" Text="Discovered files"/>
        <TextBlock Text="03" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
        <TextBlock x:Name="ExportStepText" Margin="8,0,0,0" Text="Script / EXE export"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*" MinWidth="290"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="355"/>
      </Grid.ColumnDefinitions>

      <!-- SCANNER & SERIALS -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="15">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="ScanSettingsTitle" Text="📁  Scan settings"
                         FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
              <TextBlock x:Name="FolderLabel" Text="Directory" Margin="0,0,0,7"
                         FontWeight="SemiBold"/>
              <TextBox x:Name="FolderTextBox" TextChanged="ScanSelection_Changed"
                       Margin="0,0,0,8"/>
              <Button x:Name="BrowseButton" Content="Browse..."
                      Margin="0,0,0,10" Click="Browse_Click"/>
              <CheckBox x:Name="RecursiveCheckBox" Content="Include subfolders"
                        IsChecked="True" Checked="Settings_Changed"
                        Unchecked="Settings_Changed"/>
              <TextBlock x:Name="TypesTitle" Text="File types" FontWeight="SemiBold"
                         FontSize="15" Margin="0,13,0,11"/>
              <WrapPanel>
                <CheckBox x:Name="ExeCheckBox" Content="EXE" Width="135" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                <CheckBox x:Name="MsiCheckBox" Content="MSI" Width="135" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                <CheckBox x:Name="BatCheckBox" Content="BAT" Width="135" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                <CheckBox x:Name="CmdCheckBox" Content="CMD" Width="135" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                <CheckBox x:Name="Ps1CheckBox" Content="PS1" Width="135" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                <CheckBox x:Name="Au3CheckBox" Content="AU3" Width="135" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                <CheckBox x:Name="RegCheckBox" Content="REG" Width="135" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                <CheckBox x:Name="VbsCheckBox" Content="VBS" Width="135" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
              </WrapPanel>
              <CheckBox x:Name="CustomCheckBox" Content="Custom extensions"
                        Checked="Settings_Changed" Unchecked="Settings_Changed"/>
              <TextBox x:Name="CustomTextBox" Text=".zip, .7z" Margin="0,0,0,13"
                       TextChanged="Settings_Changed"/>
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ScanButton" Content="Start scan"
                        Style="{StaticResource PrimaryButton}" Click="Scan_Click"
                        Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Stop"
                        IsEnabled="False" Click="Cancel_Click"/>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="13">
          <StackPanel>
            <TextBlock x:Name="StatsTitle" Text="◉  Statistics" FontWeight="SemiBold"
                       FontSize="15" Margin="0,0,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="StatFilesLabel" Text="Files found" Grid.Row="0"
                         Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock x:Name="StatFilesText" Text="0" Grid.Row="0" Grid.Column="1"
                         FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
              <TextBlock x:Name="StatFoldersLabel" Grid.Row="1" Text="Folders"
                         Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock x:Name="StatFoldersText" Grid.Row="1" Grid.Column="1"
                         Text="0" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatSizeLabel" Grid.Row="2" Text="Total size"
                         Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock x:Name="StatSizeText" Grid.Row="2" Grid.Column="1"
                         Text="0 B" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatTimeLabel" Grid.Row="3" Text="Scan time"
                         Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock x:Name="StatTimeText" Grid.Row="3" Grid.Column="1"
                         Text="00:00:00" FontWeight="SemiBold"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Row="4" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="13">
          <StackPanel>
            <TextBlock x:Name="SerialTitle" Text="🔑  Product key / serial"
                       FontWeight="SemiBold" FontSize="15"/>
            <TextBlock x:Name="SerialFileLabel" Text="Select an installer"
                       Margin="0,5,0,7" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="SerialTextBox" TextChanged="Serial_Changed"
                     IsEnabled="False" MaxLength="512"/>
            <Grid Margin="0,9,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="CopySerialButton" Content="Copy" IsEnabled="False"
                      Click="CopySerial_Click" Margin="0,0,5,0" Padding="4,7"/>
              <Button x:Name="SaveSerialButton" Grid.Column="1" Content="Save" IsEnabled="False"
                      Click="SaveSerial_Click" Margin="0,0,5,0" Padding="4,7"/>
              <Button x:Name="RemoveSerialButton" Grid.Column="2" Content="Remove" IsEnabled="False"
                      Click="RemoveSerial_Click" Padding="4,7"/>
            </Grid>
            <TextBlock x:Name="SerialStatusText" Margin="0,8,0,0"
                       FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- FILE LIST -->
      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="9" Padding="12">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ResultsTitle" Text="📂  Found files"
                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBox x:Name="ResultsSearchBox" Grid.Column="1"
                     TextChanged="ResultsSearch_Changed"
                     ToolTip="Filter by filename or path"/>
          </Grid>
          <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="IncludeAllButton" Content="✓  Select all"
                    Click="IncludeAll_Click" Padding="10,5" Margin="0,0,7,0"
                    IsEnabled="False"/>
            <Button x:Name="IncludeNoneButton" Grid.Column="1" Content="☐  Select none"
                    Click="IncludeNone_Click" Padding="10,5" IsEnabled="False"/>
            <TextBlock x:Name="SelectedCountText" Grid.Column="2"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}" Margin="10,0"
                       Text="0 selected"/>
            <Button x:Name="OpenFolderButton" Grid.Column="3" Content="Open folder"
                    Click="OpenFolder_Click" Padding="10,5" IsEnabled="False"/>
          </Grid>
          <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False"
                    SelectionMode="Single" SelectionChanged="FilesGrid_SelectionChanged"
                    IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="None"
                    RowHeight="33" ColumnHeaderHeight="38"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True"
                    Background="{DynamicResource FieldBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    RowBackground="{DynamicResource FieldBrush}"
                    AlternatingRowBackground="{DynamicResource PanelBrush}"
                    AlternationCount="2">
            <DataGrid.RowStyle>
              <Style TargetType="{x:Type DataGridRow}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="43">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Click="Included_Click"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="0"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="62"/>
              <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="74"/>
              <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <!-- GENERATOR & PREVIEW -->
      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="14">
          <StackPanel>
            <TextBlock x:Name="OptionsTitle" Text="⚙  Script options"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
            <TextBlock x:Name="ProjectLabel" Text="Project name"
                       FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBox x:Name="ProjectTextBox" Text="Installer"
                     TextChanged="Settings_Changed" Margin="0,0,0,11"/>
            <TextBlock x:Name="FormatLabel" Text="Export format"
                       FontWeight="SemiBold" Margin="0,0,0,7"/>
            <ComboBox x:Name="FormatCombo" SelectedIndex="0"
                      SelectionChanged="Settings_Changed" Margin="0,0,0,12">
              <ComboBoxItem Content="Batch (.bat)"/>
              <ComboBoxItem Content="Command (.cmd)"/>
              <ComboBoxItem Content="PowerShell (.ps1)"/>
              <ComboBoxItem Content="EXE launcher (.exe)"/>
            </ComboBox>
            <CheckBox x:Name="FullPathCheckBox" Content="Use absolute file paths"
                      Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <TextBlock x:Name="PathsHintText"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,-2,0,12"
                       Text="Off: installers must be beside the generated script."/>
            <CheckBox x:Name="ProgressCheckBox" Content="Progress messages"
                      IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="CompletionCheckBox" Content="Completion dialog"
                      Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <TextBox x:Name="CompletionTextBox" Text="All files have been processed."
                     TextChanged="Settings_Changed" Margin="0,0,0,10"/>
            <CheckBox x:Name="UseSerialsCheckBox"
                      Content="Copy product keys before installers" IsChecked="True"
                      Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,14"/>
            <Button x:Name="ExportButton" Content="Generate script / EXE"
                    Style="{StaticResource PrimaryButton}" IsEnabled="False"
                    Click="Export_Click" MinHeight="46"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="12">
          <DockPanel>
            <TextBlock x:Name="PreviewTitle" DockPanel.Dock="Top"
                       Text="📄  Script preview (60 items)" FontWeight="SemiBold"
                       FontSize="15" Margin="1,1,0,10"/>
            <TextBox x:Name="PreviewTextBox" AcceptsReturn="True"
                     IsReadOnly="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- GLOBAL STATUS -->
    <Border Grid.Row="3" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Margin="0,13,0,0" Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready."
                   Foreground="{DynamicResource AccentBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="ScanProgressBar" Grid.Column="1" Height="7"
                     VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource FieldBrush}"
                     IsIndeterminate="False"/>
      </Grid>
    </Border>
  </Grid>
</Window>