<Window x:Class="InstallScriptGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Script Generator 2.0" Width="1160" Height="790"
        MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#101820"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1B2733"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#101C27"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#344658"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EAF1F7"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A8B8C7"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2AAE8C"/>
    <SolidColorBrush x:Key="ActionTextBrush" Color="#FFFFFF"/>
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="35"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Install Script Generator" FontSize="25" FontWeight="Bold"/>
        <TextBlock x:Name="SubtitleText" Text="Fast directory scanning and script export"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" FontSize="13"/>
      </StackPanel>
      <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="106" Margin="8,0"
                SelectionChanged="Language_Changed" VerticalAlignment="Center">
        <ComboBoxItem Content="Deutsch"/>
        <ComboBoxItem Content="English"/>
      </ComboBox>
      <Button x:Name="ThemeButton" Grid.Column="2" Content="☀"
              Margin="0,0,8,0" VerticalAlignment="Center" Click="Theme_Click"/>
      <Button x:Name="AboutButton" Grid.Column="3" Content="About"
              VerticalAlignment="Center" Click="About_Click"/>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
            CornerRadius="9" Padding="14" Margin="0,19,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FolderLabel" Grid.Column="0" Text="Source folder"
                   VerticalAlignment="Center" Margin="0,0,11,0"/>
        <TextBox x:Name="FolderTextBox" Grid.Column="1" MinWidth="160"
                 VerticalAlignment="Center"/>
        <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..."
                Margin="9,0,0,0" Click="Browse_Click"/>
        <Button x:Name="ScanButton" Grid.Column="3" Content="Scan"
                Style="{StaticResource PrimaryButton}" Margin="9,0,0,0"
                Click="Scan_Click"/>
        <Button x:Name="CancelButton" Grid.Column="4" Content="Cancel"
                Margin="9,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
              CornerRadius="9" Padding="15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="ProjectLabel" Text="Project name"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox x:Name="ProjectTextBox" Text="Installer"
                     TextChanged="Settings_Changed" Margin="0,0,0,16"/>
            <TextBlock x:Name="TypesTitle" Text="File types" FontWeight="SemiBold"
                       FontSize="15" Margin="0,0,0,12"/>
            <CheckBox x:Name="ExeCheckBox" Content="EXE" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="MsiCheckBox" Content="MSI" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="BatCheckBox" Content="BAT" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="CmdCheckBox" Content="CMD" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="Ps1CheckBox" Content="PowerShell (PS1)" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="Au3CheckBox" Content="AutoIt (AU3)" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="RegCheckBox" Content="Registry (REG)" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="VbsCheckBox" Content="VBScript (VBS)" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="CustomCheckBox" Content="Custom extensions"
                      Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <TextBox x:Name="CustomTextBox" Text=".zip, .7z" Margin="0,0,0,16"
                     TextChanged="Settings_Changed"/>
            <TextBlock x:Name="OptionsTitle" Text="Options"
                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <CheckBox x:Name="RecursiveCheckBox" Content="Include subfolders" IsChecked="True"
                      Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="FullPathCheckBox" Content="Use absolute paths"
                      Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="ProgressCheckBox" Content="Progress messages" IsChecked="True"
                      Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="CompletionCheckBox" Content="Completion dialog"
                      Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <TextBox x:Name="CompletionTextBox" Text="All files have been processed."
                     TextChanged="Settings_Changed"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="14"/>
          <RowDefinition Height="245"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                CornerRadius="9" Padding="12">
          <DockPanel>
            <TextBlock x:Name="ResultsTitle" DockPanel.Dock="Top" Text="Discovered files"
                       FontSize="15" FontWeight="SemiBold" Margin="2,2,0,10"/>
            <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Background="{DynamicResource FieldBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      RowBackground="{DynamicResource FieldBrush}"
                      AlternatingRowBackground="{DynamicResource PanelBrush}"
                      AlternationCount="2">
              <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="70"/>
                <DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="3*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                CornerRadius="9" Padding="12">
          <DockPanel>
            <TextBlock x:Name="PreviewTitle" DockPanel.Dock="Top" Text="Script preview (first 60 files)"
                       FontSize="15" FontWeight="SemiBold" Margin="2,2,0,9"/>
            <TextBox x:Name="PreviewTextBox" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource PanelBrush}"
            CornerRadius="9" Padding="14" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="165"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
          <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis"
                     FontSize="13"/>
          <ProgressBar x:Name="ScanProgressBar" Height="5" Margin="0,9,0,0"
                       Background="{DynamicResource FieldBrush}"
                       Foreground="{DynamicResource AccentBrush}"
                       IsIndeterminate="False"/>
        </StackPanel>
        <TextBlock x:Name="FormatLabel" Grid.Column="1" Text="Export as"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="FormatCombo" Grid.Column="2" SelectedIndex="0"
                  VerticalAlignment="Center" SelectionChanged="Settings_Changed">
          <ComboBoxItem Content="BAT (.bat)"/>
          <ComboBoxItem Content="CMD (.cmd)"/>
          <ComboBoxItem Content="PowerShell (.ps1)"/>
        </ComboBox>
        <Button x:Name="ExportButton" Grid.Column="3" Content="Export script"
                Style="{StaticResource PrimaryButton}" IsEnabled="False"
                Margin="12,0,0,0" Click="Export_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
