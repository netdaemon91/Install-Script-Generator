<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InstallScriptGenerator</AssemblyName>
    <RootNamespace>InstallScriptGenerator</RootNamespace>
    <Version>2.0.0-alpha.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/isg.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/isg.ico" />
    <None Update="Assets/LauncherTemplate.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
